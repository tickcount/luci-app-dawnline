# A fuller installation, with what older versions wrote and what a hand has broken: the Go model
# (backend/model) must read it exactly as the ucode one does (scripts/ucode-golden.sh writes rich.json).

config settings 'settings'
	option portal_enabled 'yes'
	option portal_port '99999'
	option portal_host 'vpn.example.com'
	list portal_alt 'alt.example.com'
	list portal_alt ''
	list portal_alt '203.0.113.7'
	option portal_redirect 'https://example.com/'
	option default_device_limit '5'
	option hostnames 'off'
	option domain 'home.arpa'
	option geo_enabled 'TRUE'
	option geo_provider 'nowhere'
	option log_level 'debug'
	option watchdog '0'
	option log_keep_days '14'
	option log_max '50'
	option log_persist '10min'
	list log_category 'connections'
	list log_category 'problems'
	option usage_keep_days ' 90 '
	option usage_keep_months 'many'
	option home_dns_fallback 'none'
	option update_check '0'
	option update_interval '12h'
	option update_auto 'on'
	option update_mode 'immediate'
	option update_time '25:00'
	list update_targets 'app'
	list update_targets 'firmware'
	list update_targets 'amneziawg'
	option update_keep '1'

config server 'home'
	option name 'Home'
	option ifname 'dawn0'
	option port '4500'
	option subnet '10.77.0.0/24'
	option endpoint 'vpn.example.com'
	option private_key 'yAnz5TF+lXXJte14tji3zlMNq+hd2rYUIgJBgB3fBmk='
	option public_key 'xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg='
	option mtu 'auto'
	list dns '10.77.0.1'
	list dns '1.1.1.1'
	option keepalive '0'
	option preset 'quiet'
	option auto_wan '0'
	option wan_device 'pppoe-wan'
	list lan_device 'br-lan'
	list lan_device 'br-guest'
	option lan_like '0'
	option mesh 'circles'
	option jc '5'
	option jmin '11'
	option jmax '42'
	option s1 '12'
	option h1 '1'
	option i1 '<r 2><b 0x01000001000000000000>'
	option header_protection_key 'yvVKA41To0000000000000000000IUdcl4ZiyFE='
	option rekey_after_time '100-120'
	option random_trailers 'on'

config server 'cabin'
	option port 'x'
	option dns '9.9.9.9, 149.112.112.112'
	option device_mesh '0'
	option enabled '0'
	option mesh 'everyone'

config person 'anna'
	option server 'home'
	option name 'Anna'
	option access 'both'
	option device_limit '2'
	option code 'abcdef-ghijkl-mnopqr'
	option code_set '1790000000'
	option expires '2026-12-31'
	option quota_gb '1.5'
	option quota_period 'total'
	option dns_mode 'home'
	option bonus_gb '20'
	option bonus_until '1795000000'
	list service 'nas'
	list home_net 'br-lan'
	option circle 'family'
	option note 'A note, with a comma'
	option created '1780000000'

config person 'boris'
	option server 'cabin'
	option access 'everything'
	option paused '1'
	option quota_gb 'lots'
	option bonus_month '2026-12'
	option service 'nas printer'

config person 'nobody'

config device 'd_1'
	option person 'anna'
	option name 'Phone'
	option kind 'phone'
	option address '10.77.0.2'
	option public_key 'u4pL0000000000000000000000000000DyRrogDM='
	option preshared_key 'Yc0000000000000000000000000000bRABGUovbrNy4='
	option created '1780000100'
	option created_by 'portal'
	option mtu '1280'
	option keepalive '0'
	option lan_bypass '1'

config device 'd_2'
	option person 'anna'
	option kind 'toaster'
	option disabled 'yes'
	option keepalive 'often'

config device 'd_3'
	option person 'gone'
	option name 'Orphan'
	option kind 'router'
	option keepalive '60'

config circle 'family'
	option server 'home'
	option name 'Family'
	option color '11'

config service 'nas'
	option name 'NAS'
	option address '192.168.1.10'
	list port '445'
	list port '8080-8090'

config service 'printer'
	option address '192.168.1.20'
