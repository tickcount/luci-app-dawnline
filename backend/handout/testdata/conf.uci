# Configurations to hold to ucode: plain WireGuard, the junk-only disguise, the 3.1 one; home-only people with
# and without home names, internet, both; a device with its own local network outside; names in Cyrillic.
config settings 'settings'
	option portal_host 'vpn.example.com'
	option home_dns_fallback '9.9.9.9'

config server 'plain'
	option name 'Дом на море'
	option ifname 'awgplain'
	option port '51820'
	option subnet '10.9.0.0/24'
	option public_key 'xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg='
	option auto_lan '0'
	list lan_device 'dlhome'
	list lan_device 'dlguest'

config server 'junk'
	option name 'con'
	option ifname 'awgjunk'
	option port '443'
	option subnet '10.10.0.0/29'
	option endpoint '2001:db8::7'
	option public_key 'AuTb2wZ8C1032Ksn76nFgXzOJgT86OgEVbEE7ClpNy8='
	option mesh 'off'
	option keepalive '25'
	option jc '4'
	option jmin '40'
	option jmax '200'
	option s1 '15'
	option s2 '68'
	option h1 '1407'
	option h2 '2'
	option h3 '3'
	option h4 '4'
	list dns '10.10.0.1'
	list dns 'fd00::53'
	list dns '2606:4700::1111'
	list dns '192.168.50.2'
	option auto_lan '0'
	list lan_device 'dlhome'

config server 'max'
	option name 'A very long server name indeed'
	option ifname 'awgmax'
	option port '8443'
	option subnet '172.20.0.0/16'
	option public_key 'yAnz5TF+lXXJte14tji3zlMNq+hd2rYUIgJBgB3fBmk='
	option keepalive '30'
	option mtu '1420'
	option jc '10'
	option jmin '64'
	option jmax '90'
	option s4 '24'
	option h1 '100-200'
	option h2 '300-400'
	option h3 '500-600'
	option h4 '700-800'
	option i1 '<b 0x0102><r 16>'
	option header_protection_key 'yvVKA41To0000000000000000000IUdcl4Zi0000000='
	option rekey_after_time '100-140'
	option auto_lan '0'

config person 'p_net'
	option server 'plain'
	option name 'Internet'
	option access 'wan'

config person 'p_both'
	option server 'plain'
	option name 'Both'
	option access 'both'

config person 'p_lan'
	option server 'plain'
	option name 'Home'
	option access 'lan'

config person 'p_lanhome'
	option server 'plain'
	option name 'Home names'
	option access 'lan'
	option dns_mode 'home'
	list home_nets 'dlguest'

config person 'j_both'
	option server 'junk'
	option name 'Junk both'
	option access 'both'

config person 'j_lan'
	option server 'junk'
	option name 'Junk home'
	option access 'lan'
	option dns_mode 'home'

config person 'm_net'
	option server 'max'
	option name 'Max'
	option access 'wan'

config person 'lost'
	option server 'gone'
	option name 'Lost'

config device 'd_p_net_0'
	option person 'p_net'
	option name 'Device 0'
	option kind 'phone'
	option address '10.9.0.4'
	option public_key 'k00'

config device 'd_p_net_1'
	option person 'p_net'
	option name 'Device 1'
	option kind 'computer'
	option address '10.9.0.5'
	option public_key 'k01'
	option lan_bypass '1'
	option private_key 'cHJpdmF0ZXByaXZhdGVwcml2YXRlcHJpdmF0ZXByaXY='
	option preshared_key 'cHNrcHNrcHNrcHNrcHNrcHNrcHNrcHNrcHNrcHNrcHM='

