# People and devices for testdata/trace.uc: names that give one label, a device set up again, one never
# handed out, one whose configuration changed since, a person with a limit month and extra data.
config settings 'settings'
	option portal_enabled '1'
	option portal_port '8443'
	option portal_host 'vpn.example.com'
	list portal_alt '203.0.113.9'
	option hostnames '1'
	option domain 'home.arpa'

config server 'main'
	option name 'Main'
	option subnet '10.9.0.0/24'
	option public_key 'xTIBA5rboUvnH4htodjb6e697QjLERt1NAB4mZqp8Dg='
	option keepalive '25'

config server 'off'
	option subnet '10.10.0.0/24'
	option enabled '0'

config person 'anna'
	option server 'main'
	option name 'Anna'
	option code 'kamiro-telosu-bavine'
	option access 'both'
	option device_limit '5'
	option quota_gb '10'
	option bonus_gb '5'
	option bonus_until '4000000000'
	option note 'A note'
	option circle 'family'
	option created '1700000000'
	option code_set '1700000100'
	list services 'nas'
	list home_nets 'br-lan'

config person 'boris'
	option server 'main'
	option name 'Борис'
	option code 'short'
	option access 'lan'
	option expires '2099-01-01'

config person 'vera'
	option server 'off'
	option name 'Vera'
	option code 'telosu-kamiro-bavine'
	option paused '1'

config person 'nobody'
	option server 'gone'
	option name 'Nobody'

config device 'a1'
	option person 'anna'
	option name 'iPhone'
	option kind 'phone'
	option address '10.9.0.2'
	option public_key 'KEYA1'
	option private_key 'priv'
	option created '1700000300'
config device 'a2'
	option person 'anna'
	option name 'iPhone!'
	option kind 'phone'
	option address '10.9.0.3'
	option public_key 'KEYA2'
	option created '1700000200'
	option created_by 'portal'
	option mtu '1300'
	option keepalive '0'
	option lan_bypass '1'
config device 'a3'
	option person 'anna'
	option name 'Ноутбук'
	option kind 'computer'
	option address '10.9.0.4'
	option public_key 'KEYA3'
	option created '1700000400'
	option disabled '1'
config device 'a4'
	option person 'anna'
	option name '!!!'
	option kind 'router'
	option address '10.9.0.5'
	option public_key 'KEYA4'
	option created '1700000500'
config device 'b1'
	option person 'boris'
	option name 'Телефон'
	option kind 'tablet'
	option address '10.9.0.6'
	option public_key 'KEYB1'
	option created '1700000600'
config device 'v1'
	option person 'vera'
	option name 'Laptop'
	option kind 'computer'
	option address '10.10.0.2'
	option public_key 'KEYV1'
config device 'n1'
	option person 'nobody'
	option name 'Lost'
	option address '10.99.0.2'
	option public_key 'KEYN1'
