# People in every state, for testdata/trace.uc.
config settings 'settings'

config server 'on'
	option subnet '10.9.0.0/24'

config server 'off'
	option subnet '10.10.0.0/24'
	option enabled '0'

config person 'plain'
	option server 'on'
config person 'paused'
	option server 'on'
	option paused '1'
	option expires '2020-01-01'
config person 'ends'
	option server 'on'
	option expires '2027-01-15'
config person 'badend'
	option server 'on'
	option expires 'soon'
config person 'month'
	option server 'on'
	option quota_gb '1'
config person 'bonus'
	option server 'on'
	option quota_gb '1'
	option bonus_gb '2'
	option bonus_until '1800500000'
config person 'total'
	option server 'on'
	option quota_gb '0.5'
	option quota_period 'total'
config person 'legacy'
	option server 'on'
	option quota_gb '1'
config person 'nowhere'
	option server 'gone'
config person 'serveroff'
	option server 'off'
	option paused '1'
