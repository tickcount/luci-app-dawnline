config settings 'settings'
	option portal_enabled '1'
	option portal_port '4500'
	option portal_host 'vpn.example.org'
	list portal_alt '203.0.113.7'

config server 'home'
	option name 'Home'
	option ifname 'dawn0'
	option port '4500'
	option subnet '10.77.0.0/24'
	option private_key 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA='
	option public_key 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbA='
	option auto_lan '0'
	list lan_device 'dlhome'
	list lan_device 'br-lan'
	option mesh 'circles'
	option lan_like '0'

config server 'cabin'
	option name 'Cabin'
	option ifname 'dawn1'
	option port '4600'
	option subnet '10.78.0.0/24'
	option private_key 'ccccccccccccccccccccccccccccccccccccccccccA='
	option public_key 'ddddddddddddddddddddddddddddddddddddddddddA='
	option auto_lan '0'
	list lan_device 'dlhome'
	option mesh 'off'

config server 'open'
	option name 'Open'
	option ifname 'dawn2'
	option port '4700'
	option subnet '10.79.0.0/24'
	option private_key 'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeA='
	option public_key 'ffffffffffffffffffffffffffffffffffffffffffA='
	option auto_lan '0'
	list lan_device 'br-lan'
	option mesh 'all'

config circle 'fam'
	option server 'home'
	option name 'Family'

config circle 'work'
	option server 'home'
	option name 'Work'

config service 'nas'
	option name 'NAS'
	option address '192.168.77.5'
	list ports '445'
	list ports '139'

config service 'cam'
	option name 'Camera'
	option address '192.168.50.30'

config person 'anna'
	option server 'home'
	option name 'Anna'
	option access 'both'
	option circle 'fam'

config person 'boris'
	option server 'home'
	option name 'Boris'
	option access 'both'
	option circle 'fam'

config person 'clara'
	option server 'home'
	option name 'Clara'
	option access 'internet'

config person 'dima'
	option server 'home'
	option name 'Dima'
	option access 'lan'
	list home_net 'dlhome'

config person 'eva'
	option server 'home'
	option name 'Eva'
	option access 'lan'
	list service 'nas'
	list service 'cam'

config person 'fedor'
	option server 'home'
	option name 'Fedor'
	option access 'both'
	option circle 'work'

config person 'gleb'
	option server 'home'
	option name 'Gleb'
	option access 'both'
	option paused '1'

