config settings 'settings'
	option portal_enabled '1'
	option portal_port '443'
	option portal_host '203.0.113.7'

config server 'home'
	option name 'Home'
	option ifname 'dawn0'
	option port '4500'
	option subnet '10.77.0.0/24'
	option private_key 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaA='
	option auto_lan '0'
	list lan_device 'br-lan'
	option mesh 'all'
	option lan_like '1'

config server 'guest'
	option name 'Guest'
	option ifname 'dawn1'
	option port '4600'
	option subnet '10.78.0.0/24'
	option private_key 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbA='
	option auto_lan '0'
	list lan_device 'dlhome'
	list lan_device 'dlguest'
	option mesh 'off'

config server 'keyless'
	option name 'Keyless'
	option ifname 'dawn2'
	option port '4700'
	option subnet '10.79.0.0/24'

config server 'badname'
	option name 'Bad name'
	option ifname 'Not-A-Name'
	option port '4800'
	option subnet '10.80.0.0/24'
	option private_key 'ccccccccccccccccccccccccccccccccccccccccccA='

config service 'nas'
	option name 'NAS'
	option address '192.168.77.5'
	list port '445'
	list port '139'
	list port 'smb'

config service 'cam'
	option name 'Camera'
	option address '192.168.50.30'

config service 'v6'
	option name 'Six'
	option address '2001:db8::5'
	list port '80'

config person 'anna'
	option server 'home'
	option name 'Anna'
	option access 'both'

config person 'eva'
	option server 'home'
	option name 'Eva'
	option access 'lan'
	option dns_mode 'home'
	list service 'nas'
	list service 'cam'
	list service 'v6'
	list service 'gone'

config person 'dima'
	option server 'guest'
	option name 'Dima'
	option access 'lan'
	option dns_mode 'home'
	list home_net 'dlguest'

config person 'kira'
	option server 'keyless'
	option name 'Kira'
	option access 'both'

config person 'lost'
	option server 'nowhere'
	option name 'Lost'
	option access 'both'

config device 'aphone'
	option person 'anna'
	option name 'Phone'
	option address '10.77.0.2'
	option public_key 'ddddddddddddddddddddddddddddddddddddddddddA='

config device 'atwin'
	option person 'anna'
	option name 'Twin'
	option address '10.77.0.2'
	option public_key 'eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeA='

config device 'aoff'
	option person 'anna'
	option name 'Off'
	option address '10.77.0.3'
	option public_key 'ffffffffffffffffffffffffffffffffffffffffffA='
	option disabled '1'

config device 'av6'
	option person 'anna'
	option name 'Six'
	option address 'fd00::2'
	option public_key 'ggggggggggggggggggggggggggggggggggggggggggA='

config device 'ephone'
	option person 'eva'
	option name 'Phone'
	option address '10.77.0.8'
	option public_key 'hhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhhA='

