{
  "name": "dawnline-web",
  "version": "0.15.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit && tsup",
    "dev": "tsup --watch",
    "build:demo": "tsc --noEmit && tsup --config tsup.demo.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "npm run format:check && npm run typecheck && npm run i18n:check && npm run test && npm run build",
    "i18n": "node i18n/extract.ts",
    "i18n:check": "node i18n/extract.ts --check"
  },
  "dependencies": {
    "qrcode-generator": "1.4.4"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
