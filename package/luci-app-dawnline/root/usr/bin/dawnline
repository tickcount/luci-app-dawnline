#!/bin/sh
# Dawnline's command line: `dawnline help`. It is the backend's own (dawnlined cli, backend/cli).
b=/usr/libexec/dawnline/dawnlined
if [ -x "$b" ] && "$b" -version >/dev/null 2>&1; then
	exec "$b" cli "$@"
fi
echo "dawnline: the backend is not on this router yet (/usr/libexec/dawnline/fetch-backend puts it in place; logread -e dawnline says why it is missing)" >&2
exit 1
