#!/bin/sh
# Dawnline's background update worker (updater check|install|auto, see `updater help`): the backend's own
# (dawnlined updater, backend/updater).
b=/usr/libexec/dawnline/dawnlined
if [ -x "$b" ] && "$b" -version >/dev/null 2>&1; then
	exec "$b" updater "$@"
fi
logger -t dawnline -p daemon.err "[error] [update] the backend is not on this router: nothing to update with"
exit 1
